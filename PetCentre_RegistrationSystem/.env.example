# Copy this file to .env and fill in real values for your environment.
# settings.py reads these via os.environ; in production, set them as
# actual environment variables (do not commit a real .env file).

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=petcentre
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Khalti ePayment (sandbox host by default — swap to
# https://khalti.com/api/v2 with a live key for production)
KHALTI_SECRET_KEY=replace-with-your-khalti-secret-key
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# AI assistant — the n8n RAG workflow's Chat Trigger webhook (see
# rag/README.md to import + activate the workflow). Leave blank if you
# aren't running n8n; the assistant then replies that it's unavailable
# instead of breaking the page.
N8N_CHATBOT_WEBHOOK_URL=http://localhost:5678/webhook/61ad47ac-85ff-4f7c-b319-a9cef4640f38/chat
N8N_CHATBOT_TIMEOUT=60
